NODE_ENV=development
PORT=5000
MONGO_URL=mongodb://localhost:27017/nrapp
MONGO_DB_NAME=nrapp

JWT_SECRET=replace_with_at_least_32_random_characters
# Có thể tách riêng; nếu bỏ trống, User dùng JWT_SECRET để giữ tương thích.
USER_INTERNAL_SECRET=
USER_SIGNATURE_MAX_AGE_MS=300000

Rabbitmq_Host=localhost
Rabbitmq_Port=5672
Rabbitmq_Username=guest
Rabbitmq_Password=guest

# Các alias uppercase cũng được hỗ trợ khi chạy local.
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
